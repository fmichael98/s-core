{
  "name": "sapp-frontend",
  "private": true,
  "description": "SApp: pagina web (React + shadcn/ui + Tailwind), compilata con Vite in dist/ e incorporata nel server",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "bundle": "vite build",
    "build": "npm run check && npm run bundle",
    "watch": "vite build --watch"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.53.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
